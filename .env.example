# 复制为 .env，填写你要使用的服务商即可。Bun 自动读取 .env。
# 密钥只留在服务端，不会打包进浏览器。不要提交 .env。
HOST=127.0.0.1
PORT=3000

DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1-mini

ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_MODEL=gemini-2.5-flash

QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus

MOONSHOT_API_KEY=
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# MOONSHOT_MODEL=moonshot-v1-8k

SILICONFLOW_API_KEY=
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 自定义 OpenAI 兼容服务；地址仅由服务端控制以避免 SSRF。
# 例如本地 Ollama：http://127.0.0.1:11434/v1，API Key 可填写 ollama。
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
# CUSTOM_MODEL=

# 如经反向代理访问，设为浏览器中实际使用的站点源（无尾部斜杠）。
# APP_ORIGIN=https://chat.example.com
# 此应用默认用于个人本地使用。公网部署前必须添加认证、配额和限流。
