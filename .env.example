# 复制为 .env，填写 DeepSeek 密钥。Bun 自动读取 .env。
# 密钥只留在服务端，不会打包进浏览器。不要提交 .env。
HOST=127.0.0.1
PORT=3000

DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# 如经反向代理访问，设为浏览器中实际使用的站点源（无尾部斜杠）。
# APP_ORIGIN=https://chat.example.com
# 此应用默认用于个人本地使用。公网部署前必须添加认证、配额和限流。
